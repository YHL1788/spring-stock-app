import { NextRequest, NextResponse } from 'next/server';
import { FieldValue, Timestamp } from 'firebase-admin/firestore';
import { getAdminDb, getServerAppId } from '@/app/lib/firebaseAdmin';
import { calculateStocksDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/stocksDisplayEngine';
import { calculateFCNDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/fcnDisplayEngine';
import { calculateDQAQDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/dqaqDisplayEngine';
import { calculateOptionDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/optionDisplayEngine';
import { calculateCashDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/cashDisplayEngine';
import { calculateSummaryDisplayCache } from '@/app/book/SP_wjhh1/lib/displayCacheEngines/summaryDisplayEngine';

export const dynamic = 'force-dynamic';
export const runtime = 'nodejs';

const LOCK_COLLECTION = 'sip_display_cache_locks';
const RUNS_COLLECTION = 'sip_display_cache_runs';
const CURRENT_COLLECTION = 'sip_display_cache_current';
const LATEST_COLLECTION = 'sip_display_cache_latest';
const LOCK_ID = 'global';
const LATEST_ID = 'current';
const LOCK_TTL_MS = 15 * 60 * 1000;
const RUN_REPORT_KEEP_COUNT = 5;

const createRunId = () => {
  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  const random = Math.random().toString(36).slice(2, 8);
  return `display_${stamp}_${random}`;
};

const getDataCollection = (collectionName: string) => {
  const appId = getServerAppId();
  return getAdminDb()
    .collection('artifacts')
    .doc(appId)
    .collection('public')
    .doc('data')
    .collection(collectionName);
};

const getDataDoc = (collectionName: string, docId: string) => {
  return getDataCollection(collectionName).doc(docId);
};

const validateSecret = (request: NextRequest) => {
  const expectedSecrets = [process.env.DISPLAY_REFRESH_SECRET, process.env.CRON_SECRET]
    .filter((value): value is string => Boolean(value));
  if (expectedSecrets.length === 0) {
    return { ok: true, warning: 'DISPLAY_REFRESH_SECRET/CRON_SECRET is not configured; request accepted without secret.' };
  }
  const provided = request.nextUrl.searchParams.get('secret')
    || request.headers.get('x-display-refresh-secret')
    || request.headers.get('authorization')?.replace(/^Bearer\s+/i, '');
  return { ok: Boolean(provided && expectedSecrets.includes(provided)), warning: '' };
};

const isVercelCronRequest = (request: NextRequest) => Boolean(request.headers.get('x-vercel-cron'));

const getBeijingClock = (date = new Date()) => {
  const utcMs = date.getTime() + date.getTimezoneOffset() * 60 * 1000;
  const beijing = new Date(utcMs + 8 * 60 * 60 * 1000);
  return {
    hour: beijing.getHours(),
    minute: beijing.getMinutes(),
    isoDate: beijing.toISOString().slice(0, 10),
  };
};

const isWithinBeijingAutoRefreshWindow = (date = new Date()) => {
  const { hour, minute } = getBeijingClock(date);
  const minutesOfDay = hour * 60 + minute;
  return minutesOfDay >= 7 * 60 && minutesOfDay <= 16 * 60 + 30;
};

const acquireLock = async (runId: string) => {
  const db = getAdminDb();
  const lockRef = getDataDoc(LOCK_COLLECTION, LOCK_ID);
  const now = new Date();
  const expiresAt = new Date(now.getTime() + LOCK_TTL_MS);

  await db.runTransaction(async (transaction) => {
    const snap = await transaction.get(lockRef);
    const data = snap.exists ? snap.data() : null;
    const currentExpiresAt = data?.expiresAt?.toDate?.() as Date | undefined;
    const isActive = data?.locked === true && currentExpiresAt && currentExpiresAt.getTime() > now.getTime();
    if (isActive) {
      throw new Error(`Display cache refresh is already running: ${data?.runId || 'unknown'}`);
    }
    transaction.set(lockRef, {
      locked: true,
      runId,
      status: 'running',
      owner: 'refresh-display-cache-api',
      startedAt: Timestamp.fromDate(now),
      expiresAt: Timestamp.fromDate(expiresAt),
      updatedAt: FieldValue.serverTimestamp(),
    });
  });
};

const releaseLock = async (runId: string, status: 'success' | 'failed') => {
  await getDataDoc(LOCK_COLLECTION, LOCK_ID).set({
    locked: false,
    runId,
    status,
    releasedAt: FieldValue.serverTimestamp(),
    updatedAt: FieldValue.serverTimestamp(),
  }, { merge: true });
};

const pruneOldRunReports = async () => {
  const snapshot = await getDataCollection(RUNS_COLLECTION)
    .orderBy('startedAt', 'desc')
    .get();
  const docsToDelete = snapshot.docs.slice(RUN_REPORT_KEEP_COUNT);
  if (docsToDelete.length === 0) return 0;

  let deleted = 0;
  for (let index = 0; index < docsToDelete.length; index += 450) {
    const batch = getAdminDb().batch();
    docsToDelete.slice(index, index + 450).forEach((doc) => {
      batch.delete(doc.ref);
      deleted += 1;
    });
    await batch.commit();
  }
  return deleted;
};

const buildStocksReport = (stocksResult: Awaited<ReturnType<typeof calculateStocksDisplayCache>>) => {
  const { data } = stocksResult;
  return {
    status: stocksResult.status,
    holdings: data.holdings.length,
    grossMktValHKD: data.holdingSums.grossMktValHKD,
    mktValHKD: data.holdingSums.mktValHKD,
    unrealizedPnlHKD: data.holdingSums.unrealizedPnlHKD,
    missingQuoteCount: data.quoteStatus.missingQuoteCodes.length,
    requestedSymbols: data.quoteStatus.requestedSymbols.length,
    rawCounts: data.rawCounts,
  };
};

const buildFCNReport = (fcnResult: Awaited<ReturnType<typeof calculateFCNDisplayCache>>) => {
  const { data } = fcnResult;
  return {
    status: fcnResult.status,
    currentMarkets: data.currentMktStats.markets.length,
    currentAccounts: data.currentMktStats.accounts.length,
    riskUnderlyings: data.riskExposureSummary.length,
    missingQuoteCount: data.quoteStatus.missingQuoteCodes.length,
    requestedSymbols: data.quoteStatus.requestedSymbols.length,
    rawCounts: data.rawCounts,
  };
};

const buildDQAQReport = (dqaqResult: Awaited<ReturnType<typeof calculateDQAQDisplayCache>>) => {
  const { data } = dqaqResult;
  return {
    status: dqaqResult.status,
    currentMarkets: data.currentMktStats.markets.length,
    currentAccounts: data.currentMktStats.accounts.length,
    riskUnderlyings: data.riskExposureSummary.length,
    missingQuoteCount: data.quoteStatus.missingQuoteCodes.length,
    requestedSymbols: data.quoteStatus.requestedSymbols.length,
    rawCounts: data.rawCounts,
  };
};

const buildOptionReport = (optionResult: Awaited<ReturnType<typeof calculateOptionDisplayCache>>) => {
  const { data } = optionResult;
  return {
    status: optionResult.status,
    currentMarkets: data.currentMktStats.markets.length,
    currentAccounts: data.currentMktStats.accounts.length,
    riskUnderlyings: data.riskExposureSummary.length,
    missingQuoteCount: data.quoteStatus.missingQuoteCodes.length,
    requestedSymbols: data.quoteStatus.requestedSymbols.length,
    rawCounts: data.rawCounts,
  };
};

const buildCashReport = (cashResult: Awaited<ReturnType<typeof calculateCashDisplayCache>>) => {
  const { data } = cashResult;
  return {
    status: cashResult.status,
    currentMarkets: data.currentCashStats.markets.length,
    currentAccounts: data.currentCashStats.accounts.length,
    plMarkets: data.currentPlStats.markets?.length || 0,
    rawCounts: data.rawCounts,
  };
};

const buildSummaryReport = (summaryResult: Awaited<ReturnType<typeof calculateSummaryDisplayCache>>) => {
  const { snapshot, rawCounts } = summaryResult.data;
  return {
    status: summaryResult.status,
    totalMarketValueHKD: snapshot.totalMarketValueHKD,
    totalPnlHKD: snapshot.totalPnlHKD,
    displayCacheInputs: rawCounts.displayCacheInputs.length,
    formalSummaryInputs: rawCounts.formalSummaryInputs.length,
    missingInputs: rawCounts.missingInputs,
  };
};

async function handleRefresh(request: NextRequest) {
  const secretResult = validateSecret(request);
  if (!secretResult.ok) {
    return NextResponse.json({ ok: false, error: 'Unauthorized display refresh request.' }, { status: 401 });
  }

  if (isVercelCronRequest(request) && !isWithinBeijingAutoRefreshWindow()) {
    const beijingClock = getBeijingClock();
    return NextResponse.json({
      ok: true,
      status: 'skipped_outside_window',
      message: 'Cron display refresh skipped outside Beijing auto-refresh window.',
      beijingTime: `${beijingClock.isoDate} ${String(beijingClock.hour).padStart(2, '0')}:${String(beijingClock.minute).padStart(2, '0')}`,
      allowedWindow: '07:00-16:30 Asia/Shanghai',
    }, { headers: { 'Cache-Control': 'no-store' } });
  }

  const runId = createRunId();
  const startedAt = new Date();
  const runRef = getDataDoc(RUNS_COLLECTION, runId);
  const infrastructureCurrentRef = getDataDoc(CURRENT_COLLECTION, 'infrastructure');
  const stocksCurrentRef = getDataDoc(CURRENT_COLLECTION, 'stocks');
  const fcnCurrentRef = getDataDoc(CURRENT_COLLECTION, 'fcn');
  const dqaqCurrentRef = getDataDoc(CURRENT_COLLECTION, 'dqaq');
  const optionCurrentRef = getDataDoc(CURRENT_COLLECTION, 'option');
  const cashCurrentRef = getDataDoc(CURRENT_COLLECTION, 'cash');
  const summaryCurrentRef = getDataDoc(CURRENT_COLLECTION, 'summary');
  const latestRef = getDataDoc(LATEST_COLLECTION, LATEST_ID);

  try {
    await acquireLock(runId);
    await runRef.set({
      runId,
      status: 'running',
      mode: 'display_cache',
      triggeredBy: request.headers.get('x-vercel-cron') ? 'vercel-cron' : 'manual-api',
      startedAt: Timestamp.fromDate(startedAt),
      warnings: secretResult.warning ? [secretResult.warning] : [],
      modules: {},
      source: 'backend-display-cache',
      updatedAt: FieldValue.serverTimestamp(),
    });

    await infrastructureCurrentRef.set({
      runId,
      module: 'infrastructure',
      status: 'success',
      calculatedAt: FieldValue.serverTimestamp(),
      data: {
        message: 'Display cache backend infrastructure is reachable.',
        formalBookDataTouched: false,
      },
      warnings: [],
      errors: [],
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const stocksResult = await calculateStocksDisplayCache();
    await stocksCurrentRef.set({
      runId,
      module: 'stocks',
      status: stocksResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: stocksResult.data,
      warnings: stocksResult.warnings,
      errors: stocksResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const fcnResult = await calculateFCNDisplayCache();
    await fcnCurrentRef.set({
      runId,
      module: 'fcn',
      status: fcnResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: fcnResult.data,
      warnings: fcnResult.warnings,
      errors: fcnResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const dqaqResult = await calculateDQAQDisplayCache();
    await dqaqCurrentRef.set({
      runId,
      module: 'dqaq',
      status: dqaqResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: dqaqResult.data,
      warnings: dqaqResult.warnings,
      errors: dqaqResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const optionResult = await calculateOptionDisplayCache();
    await optionCurrentRef.set({
      runId,
      module: 'option',
      status: optionResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: optionResult.data,
      warnings: optionResult.warnings,
      errors: optionResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const cashResult = await calculateCashDisplayCache();
    await cashCurrentRef.set({
      runId,
      module: 'cash',
      status: cashResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: cashResult.data,
      warnings: cashResult.warnings,
      errors: cashResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const summaryResult = await calculateSummaryDisplayCache();
    await summaryCurrentRef.set({
      runId,
      module: 'summary',
      status: summaryResult.status,
      calculatedAt: FieldValue.serverTimestamp(),
      data: summaryResult.data,
      warnings: summaryResult.warnings,
      errors: summaryResult.errors,
      source: 'backend-display-cache',
      formalBookDataTouched: false,
    });

    const finishedAt = new Date();
    const runStatus = stocksResult.status === 'success' && fcnResult.status === 'success' && dqaqResult.status === 'success' && optionResult.status === 'success' && cashResult.status === 'success' && summaryResult.status === 'success' ? 'success' : 'partial_success';
    const runWarnings = [
      ...(secretResult.warning ? [secretResult.warning] : []),
      ...stocksResult.warnings,
      ...fcnResult.warnings,
      ...dqaqResult.warnings,
      ...optionResult.warnings,
      ...cashResult.warnings,
      ...summaryResult.warnings,
    ];
    const moduleReports = {
      infrastructure: {
        status: 'success',
        message: 'Display cache backend infrastructure is reachable.',
      },
      stocks: buildStocksReport(stocksResult),
      fcn: buildFCNReport(fcnResult),
      dqaq: buildDQAQReport(dqaqResult),
      option: buildOptionReport(optionResult),
      cash: buildCashReport(cashResult),
      summary: buildSummaryReport(summaryResult),
    };
    await runRef.set({
      status: runStatus,
      finishedAt: Timestamp.fromDate(finishedAt),
      modules: {
        infrastructure: 'success',
        stocks: stocksResult.status,
        fcn: fcnResult.status,
        dqaq: dqaqResult.status,
        option: optionResult.status,
        cash: cashResult.status,
        summary: summaryResult.status,
      },
      moduleReports,
      warnings: runWarnings,
      currentDocs: {
        infrastructure: `${CURRENT_COLLECTION}/infrastructure`,
        stocks: `${CURRENT_COLLECTION}/stocks`,
        fcn: `${CURRENT_COLLECTION}/fcn`,
        dqaq: `${CURRENT_COLLECTION}/dqaq`,
        option: `${CURRENT_COLLECTION}/option`,
        cash: `${CURRENT_COLLECTION}/cash`,
        summary: `${CURRENT_COLLECTION}/summary`,
      },
      updatedAt: FieldValue.serverTimestamp(),
    }, { merge: true });

    await latestRef.set({
      runId,
      status: runStatus,
      completedAt: Timestamp.fromDate(finishedAt),
      modules: {
        infrastructure: 'success',
        stocks: stocksResult.status,
        fcn: fcnResult.status,
        dqaq: dqaqResult.status,
        option: optionResult.status,
        cash: cashResult.status,
        summary: summaryResult.status,
      },
      currentDocs: {
        infrastructure: `${CURRENT_COLLECTION}/infrastructure`,
        stocks: `${CURRENT_COLLECTION}/stocks`,
        fcn: `${CURRENT_COLLECTION}/fcn`,
        dqaq: `${CURRENT_COLLECTION}/dqaq`,
        option: `${CURRENT_COLLECTION}/option`,
        cash: `${CURRENT_COLLECTION}/cash`,
        summary: `${CURRENT_COLLECTION}/summary`,
      },
      moduleReports,
      warnings: runWarnings,
      source: 'backend-display-cache',
      updatedAt: FieldValue.serverTimestamp(),
    }, { merge: true });

    const prunedRunReports = await pruneOldRunReports();
    await releaseLock(runId, 'success');
    return NextResponse.json({
      ok: true,
      runId,
      status: runStatus,
      currentDocs: {
        infrastructure: `${CURRENT_COLLECTION}/infrastructure`,
        stocks: `${CURRENT_COLLECTION}/stocks`,
        fcn: `${CURRENT_COLLECTION}/fcn`,
        dqaq: `${CURRENT_COLLECTION}/dqaq`,
        option: `${CURRENT_COLLECTION}/option`,
        cash: `${CURRENT_COLLECTION}/cash`,
        summary: `${CURRENT_COLLECTION}/summary`,
      },
      modules: {
        infrastructure: 'success',
        stocks: stocksResult.status,
        fcn: fcnResult.status,
        dqaq: dqaqResult.status,
        option: optionResult.status,
        cash: cashResult.status,
        summary: summaryResult.status,
      },
      moduleReports,
      warnings: runWarnings,
      prunedRunReports,
    }, { headers: { 'Cache-Control': 'no-store' } });
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    await runRef.set({
      runId,
      status: 'failed',
      errorMessage: message,
      finishedAt: FieldValue.serverTimestamp(),
      updatedAt: FieldValue.serverTimestamp(),
    }, { merge: true }).catch(() => {});
    await pruneOldRunReports().catch(() => {});
    await releaseLock(runId, 'failed').catch(() => {});
    const status = message.includes('already running') ? 423 : 500;
    return NextResponse.json({ ok: false, runId, error: message }, { status, headers: { 'Cache-Control': 'no-store' } });
  }
}

export async function GET(request: NextRequest) {
  return handleRefresh(request);
}

export async function POST(request: NextRequest) {
  return handleRefresh(request);
}
